# Submission archive built by manuscript/update.py --archive
manuscript/flat_submission.zip

# manuscript/flat_submission is an Overleaf-bridged git repo, deliberately NOT
# tracked by this repo: no gitlink or .gitmodules is ever committed, so GitHub
# never sees the manuscript sources. Overleaf's git is its only remote; its
# ignores live in its own .gitignore (build artifacts stay on disk for
# update.py --archive).
manuscript/flat_submission/
.gitmodules
# R1.4 head ablation feature cache (reproducible in one forward pass)
pelage_sorting/results/04_head_ablation/features.npz

# Re-id embeddings and t-SNE coordinates (Figure 7 inputs): tracked despite
# the global *.npz rule, following the flat_submission !*.png precedent
!reid_openset/*/results/embeddings/*.npz
!reid_openset/summary/tsne/tsne_raw_*.npz
